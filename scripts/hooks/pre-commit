#!/bin/sh
#
# Refuses a commit that carries a macOS duplicate file.
#
# These are the "bell 2.tsx" copies the Finder leaves behind. Twelve reached the
# remote once, one of them a copy of a migration whose version was already in
# the ledger, which the next db push would have picked up and turned into a
# version collision. `npm run clean:dupes` removes them from disk, but the disk
# is not where they do harm.
#
# Run straight from here, not from a copy in .git/hooks.
#
# `scripts/install-hooks.mjs` points git's core.hooksPath at this directory, so
# the file that runs is the file in the repository. The copying it used to do
# drifted in silence: on 2026-08-19 a migration collision reached the remote
# with this guard already written and merged, because the installed copy was
# two days old and nobody had run npm install since.
#
# A self check inside the hook cannot fix that, since a copy older than the
# check does not contain it. Removing the copy removes the whole class.


dupes=$(git diff --cached --name-only --diff-filter=A | grep -E ' [0-9]+\.[A-Za-z]+$')

if [ -n "$dupes" ]; then
  echo "Refusing to commit duplicate files:"
  echo "$dupes" | sed 's/^/  /'
  echo
  echo "These are Finder copies. Remove them:"
  echo "  npm run clean:dupes"
  echo "  git rm --cached <path>   # if one is already staged"
  echo
  echo "A copy of a migration claims a version already in the ledger."
  exit 1
fi

# ---------------------------------------------------------------------------
# Refuses a migration whose version is already taken.
#
# Two sessions mint timestamps by hand in the same folder, and the ledger
# keys on version alone: the second file with the same number is silently
# never recorded, and db:reset dies on the duplicate key. This happened for
# real on 2026-08-18. The parity note below is the convention that prevents
# it, printed so the hook teaches instead of only blocking.
# ---------------------------------------------------------------------------

staged_migs=$(git diff --cached --name-only --diff-filter=A | grep -E '^supabase/migrations/[0-9]{14}_' || true)

for f in $staged_migs; do
  v=$(basename "$f" | cut -c1-14)
  existing=$(ls supabase/migrations/ 2>/dev/null | grep -c "^${v}_" || true)
  if [ "$existing" -gt 1 ]; then
    echo "Refusing to commit: migration version $v is already taken:"
    ls supabase/migrations/ | grep "^${v}_" | sed 's/^/  /'
    echo
    echo "Rename yours to a free slot. Convention between the two sessions:"
    echo "  EVEN hour digits (00,02,04,...) -> cisca-50's session"
    echo "  ODD  hour digits (01,03,05,...) -> the ops session"
    exit 1
  fi
done
