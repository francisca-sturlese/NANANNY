#!/bin/sh
#
# Refuses a commit that carries a macOS duplicate file.
#
# These are the "bell 2.tsx" copies the Finder leaves behind. Twelve reached the
# remote once, one of them a copy of a migration whose version was already in
# the ledger, which the next db push would have picked up and turned into a
# version collision. `npm run clean:dupes` removes them from disk, but the disk
# is not where they do harm.
#
# Not installed by the repo: git hooks are per checkout. See docs/deployment.md.

dupes=$(git diff --cached --name-only --diff-filter=A | grep -E ' [0-9]+\.[A-Za-z]+$')

if [ -n "$dupes" ]; then
  echo "Refusing to commit duplicate files:"
  echo "$dupes" | sed 's/^/  /'
  echo
  echo "These are Finder copies. Remove them:"
  echo "  npm run clean:dupes"
  echo "  git rm --cached <path>   # if one is already staged"
  echo
  echo "A copy of a migration claims a version already in the ledger."
  exit 1
fi
