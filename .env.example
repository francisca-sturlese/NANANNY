# Copy to .env.local and fill in. Never commit real values.
#
# Local development uses the Supabase CLI stack on dedicated ports
# (API 54421, Postgres 54422, Studio 54423, Mailpit 54424) so it cannot
# collide with any other project running on this machine.
# Run `npm run db:start`, then `npx supabase status -o env` for the local keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# Email (Milestone 5). Empty locally: Mailpit captures everything on 54424.
RESEND_API_KEY=
EMAIL_FROM=NaNanny UAE <hello@nananny.com>
EMAIL_REPLY_TO_BILLING=billing@nananny.com

# Stripe (Milestone 5). Test mode keys only until Federico switches to live.
# The webhook secret comes from `stripe listen` locally, or from the endpoint
# you create in the dashboard. Without both set, billing stays switched off and
# the app says so rather than failing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
